# Scratch: extraction output, disassembly, rendered audio. All reproducible
# from the ROM with `make extract`.
out/

# The ROM itself, and the user's save files.
*.nds
*.SAV
*.sav
songs/

# Test vectors are regenerated from the ROM by `make test`. ~25 MB, and they
# change whenever a test does, so they stay out of history. The small, stable
# ROM-derived inputs live in data/ and are committed.
tests/vectors/
!tests/vectors/drumbuf.bin

# Build output
build/
web/build/
*.o
*.a

# ctags output
tags

__pycache__/
